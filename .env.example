# Wajib: lokasi berkas SQLite (path relatif dari direktori kerja proses).
DATABASE_URL="file:./dev.db"

# Wajib: minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="generate-a-random-secret-at-least-32-characters"

# Opsional: set ke "true" untuk membuat akun demo saat menjalankan `npx prisma db seed`.
# Jangan aktifkan pada lingkungan yang dapat diakses publik.
# SEED_DEMO_USERS="true"

# Wajib hanya bila SEED_DEMO_USERS=true. Minimal 10 karakter dan sebaiknya berbeda.
# DEMO_OWNER_PASSWORD="replace-with-a-unique-password"
# DEMO_ADMIN_PASSWORD="replace-with-a-unique-password"
# DEMO_CASHIER_PASSWORD="replace-with-a-unique-password"
